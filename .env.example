# byjwu (the conductor engine) reads these. Dry-run is the default and needs no key.
# `--live` needs at least one engine key.
#
# Jev makes the linear calls. OpenRouter wins when both Jev keys are set.
# CONDUCTOR_JEV_PROVIDER=typesafe forces the other. Without a Jev key, linear
# calls use the deterministic rules at reduced confidence.

OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Taste calls default to grok-4.7-medium (CONDUCTOR_TASTE_MODEL). A Cursor
# slug, including that default, goes through the Cursor CLI (cursor-agent)
# with CURSOR_API_KEY. CONDUCTOR_TASTE_BACKEND=anthropic uses ANTHROPIC_API_KEY
# instead. Opus is optional and off unless the taste model is a Claude id.
# With no backend, creative calls become review markers. CURSOR_AUTH_TOKEN
# is never passed on. Linear calls stay on Jev.

CURSOR_API_KEY=
ANTHROPIC_API_KEY=

# Optional. cursor | anthropic | auto (auto prefers Cursor).
# CONDUCTOR_OPUS_BACKEND=auto
# CURSOR_AGENT_BIN=~/.local/bin/cursor-agent
# CONDUCTOR_OPUS_TIMEOUT=120

# Optional. Pin a model or point at a proxy. The taste default is grok-4.7-medium.
# CONDUCTOR_JEV_MODEL=
# CONDUCTOR_OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions
# CONDUCTOR_TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# CONDUCTOR_JEV_PROVIDER=openrouter
# CONDUCTOR_TASTE_MODEL=grok-4.7-medium
# CONDUCTOR_OPUS_MODEL=claude-opus-5-5
# CONDUCTOR_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
# CONDUCTOR_OPUS_EFFORT=medium

# Set to 1 to force both local mocks even when --live is passed.
# CONDUCTOR_DRY_RUN=1
