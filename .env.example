# Cut Conductor reads these. Dry-run is the default and needs no key.
# `--live` needs at least one engine key.
#
# Jev makes the linear calls. OpenRouter wins when both Jev keys are set.
# CONDUCTOR_JEV_PROVIDER=typesafe forces the other. Without a Jev key, linear
# calls use the deterministic rules at reduced confidence.

OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Claude Opus makes the creative calls. Without this key they become review
# markers and nothing creative is auto-applied.

ANTHROPIC_API_KEY=

# Optional. Pin a model or point at a proxy. Grok/xAI models are refused.
# CONDUCTOR_JEV_MODEL=
# CONDUCTOR_OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions
# CONDUCTOR_TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# CONDUCTOR_JEV_PROVIDER=openrouter
# CONDUCTOR_OPUS_MODEL=claude-opus-5-5
# CONDUCTOR_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
# CONDUCTOR_OPUS_EFFORT=medium

# Set to 1 to force both local mocks even when --live is passed.
# CONDUCTOR_DRY_RUN=1
