# Cut Conductor reads these. Dry-run is the default and needs neither key.
# `python -m conductor apply --live` uses the first one that is set.
# OpenRouter wins when both are set. CONDUCTOR_JEV_PROVIDER=typesafe forces the other.

OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional. Pin a model or point at a proxy.
# CONDUCTOR_JEV_MODEL=
# CONDUCTOR_OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions
# CONDUCTOR_TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# CONDUCTOR_JEV_PROVIDER=openrouter

# Set to 1 to force the local mock even when --live is passed.
# CONDUCTOR_DRY_RUN=1
