<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jevid.room-run</string>
	<key>WorkingDirectory</key>
	<string>/Users/CHANGE_ME/jevid</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/CHANGE_ME/jevid/.venv/bin/python</string>
		<string>-m</string>
		<string>conductor</string>
		<string>room-run</string>
		<string>--watch</string>
		<string>/Users/CHANGE_ME/Desktop/jevid-in</string>
		<string>--out-root</string>
		<string>/Users/CHANGE_ME/Desktop/jevid-out</string>
		<string>--brief</string>
		<string>A tight interview. Keep the guest's story, lose dead air.</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/CHANGE_ME/Library/Logs/jevid/room-run.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/CHANGE_ME/Library/Logs/jevid/room-run.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
