<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
  <resources>
    <format id="r1" name="FFVideoFormat1080p24" frameDuration="1/24s" width="1920" height="1080"/>
    <asset id="r2" name="interview" uid="A-INTERVIEW" start="0s" duration="600s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48000">
      <media-rep kind="original-media" src="file:///media/library/interview.mov"/>
    </asset>
    <asset id="r3" name="broll" uid="A-BROLL" start="0s" duration="120s" hasVideo="1" hasAudio="1" format="r1">
      <media-rep kind="original-media" src="file:///media/library/broll.mov"/>
    </asset>
  </resources>
  <library location="file:///media/library/Interview.fcpbundle">
    <event name="Interview" uid="E-INTERVIEW">
      <project name="Rough Cut" uid="P-ROUGH">
        <sequence format="r1" duration="377/6s" tcStart="0s" tcFormat="NDF">
          <spine>
            <asset-clip ref="r2" offset="0s" name="Cold open" start="12s" duration="8s" tcFormat="NDF" audioRole="dialogue">
              <asset-clip ref="r3" lane="1" offset="13s" name="Lower third" start="0s" duration="4s" videoRole="titles"/>
              <marker start="14s" duration="1/24s" value="Keep this" note="human marker"/>
              <audio-channel-source srcCh="1,2" role="dialogue.dialogue-1"/>
            </asset-clip>
            <gap name="Gap" offset="8s" start="3600s" duration="5/2s"/>
            <asset-clip ref="r2" offset="21/2s" name="Flash frame" start="80s" duration="1/3s" audioRole="dialogue"/>
            <asset-clip ref="r2" offset="65/6s" name="Guest explains" start="100s" duration="18s" audioRole="dialogue">
              <keyword start="100s" duration="18s" value="interview"/>
            </asset-clip>
            <asset-clip ref="r3" offset="173/6s" name="B-roll static hold" start="0s" duration="28s" videoRole="video" audioRole="effects"/>
            <asset-clip ref="r2" offset="341/6s" name="Button" start="200s" duration="6s" audioRole="dialogue"/>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
