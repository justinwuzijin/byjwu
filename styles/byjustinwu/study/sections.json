{
  "about": "Hand labels of section type per time range. analyze.py reads these and computes every number from the local bundle. Video ids are not stored here; aliases (long_a, long_b, long_c, short) map through the gitignored study/data/sources.json.",
  "section_types": {
    "talking": "on-camera speech to the lens, diegetic audio. bed=true means a music bed runs under it",
    "confessional": "webcam talking head (Photo Booth screen recording on the macOS desktop)",
    "vlog": "handheld with people, diegetic audio and speech, not addressed to the lens",
    "broll": "music-led b-roll; captions=narration means silent written narration sits on it",
    "montage": "music-only, cut to the track, no narration",
    "monologue": "voice-over over a held music bed, verbatim captions",
    "chapter_card": "full-frame title card (glitch field, rectangle collage, title, date stamp) or a colour flash",
    "end_card": "closing tagline or brand card"
  },
